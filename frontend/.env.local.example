# Backend base URL (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: ElevenLabs Conversational AI agent id. When set, a voice widget appears on results.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Optional: public URL of the frontend, used for absolute Open Graph / social preview links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
