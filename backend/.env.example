# Copy to backend/.env (never commit the real file) and fill in values.
ENVIRONMENT=development

# ── Required ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Optional: ElevenLabs voice features ──
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_NARRATOR_VOICE_ID=
# ELEVENLABS_RISK_HUNTER_VOICE_ID=
# ELEVENLABS_DEFENDER_VOICE_ID=
# Bearer token the ElevenLabs agent sends to /v1/chat/completions (endpoint disabled if empty).
CUSTOM_LLM_API_KEY=

# ── Optional: Twilio phone briefings ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS URL Twilio can reach (ngrok URL for local dev).
PUBLIC_BASE_URL=
# Bearer token required by POST /api/twilio/call (endpoint disabled if empty).
ADMIN_API_TOKEN=
# Secret for signing TTS URLs; defaults to TWILIO_AUTH_TOKEN.
TTS_SIGNING_SECRET=

# ── Optional: GCP persistence (Firestore is used when ENVIRONMENT=production or GCP_PROJECT_ID is set) ──
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
FIRESTORE_COLLECTION=analyses
